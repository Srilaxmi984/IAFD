# data and models stay local (PaySim CSV is ~470 MB; GitHub blocks files >100 MB)
data/raw/*
data/processed/*
models/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep

__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
.env
*.joblib
*.parquet
*.csv
!reports/*.csv
reports/*predictions*.csv

# dev-sample results and temporary runs are not reportable
reports/experiment_dev_*
reports/figures/shap/
reports/shap_importance_*.csv
reports/shap_local_explanations.json

*.log
